# FlowPilot Environment Configuration
# Copy to .env and fill in real values

# Server
FLOWPILOT_ENV=development
FLOWPILOT_PORT=8000
FLOWPILOT_DB_PATH=./data/flowpilot.db
FLOWPILOT_CORS_ORIGINS=http://localhost:5173
FLOWPILOT_LOG_LEVEL=INFO

# LLM Provider
FLOWPILOT_DEFAULT_PROVIDER=deterministic
GEMINI_API_KEY=
# Override with a model available to your API key.
FLOWPILOT_GEMINI_MODEL=gemini-2.5-flash
FLOWPILOT_LLM_TIMEOUT_S=30

# Demo Clock (ISO8601, optional — omit for real time)
FLOWPILOT_DEMO_TIMESTAMP=2026-10-22T09:00:00+05:30
