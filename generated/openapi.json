            "type": "boolean",
            "title": "Seeded"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "state_version",
          "provider",
          "seeded"
        ],
        "title": "SessionResponse",
        "description": "Represent the documented SessionResponse contract."
      },
      "TasksResponse": {
        "properties": {
