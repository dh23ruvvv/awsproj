  "components": {
    "schemas": {
      "AgentMessageRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          },
          "state_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "State Version"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AgentMessageRequest",
        "description": "Validate an utterance and its optional client state version."
      },
      "AgentMessageResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          },
          "plan_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Id"
          },
          "has_proposal": {
            "type": "boolean",
            "title": "Has Proposal",
            "default": false
          },
          "state_version": {
            "type": "integer",
            "title": "State Version",
            "default": 1
          },
          "provider_used": {
            "type": "string",
            "title": "Provider Used",
            "default": "deterministic"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "default": false
          },
          "tool_trace": {
            "items": {
              "$ref": "#/components/schemas/ToolTraceItem"
            },
            "type": "array",
            "title": "Tool Trace"
          }
        },
        "type": "object",
        "required": [
          "response"
        ],
        "title": "AgentMessageResponse",
        "description": "Represent the documented AgentMessageResponse contract."
      },
      "CancelResponse": {
        "properties": {
          "cancelled": {
            "type": "boolean",
            "title": "Cancelled"
          },
          "state_version": {
            "type": "integer",
            "title": "State Version"
          }
        },
        "type": "object",
        "required": [
          "cancelled",
          "state_version"
        ],
        "title": "CancelResponse",
        "description": "Represent the documented Cancel plan response."
      },
      "ConfirmRequest": {
        "properties": {
          "state_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "State Version"
          }
        },
        "type": "object",
        "title": "ConfirmRequest",
        "description": "Accept an optional version defaulting to the proposal snapshot."
      },
      "ConfirmResponse": {
        "properties": {
          "committed": {
            "type": "boolean",
            "title": "Committed"
          },
          "state_version": {
            "type": "integer",
            "title": "State Version"
          },
          "already_executed": {
            "type": "boolean",
            "title": "Already Executed",
            "default": false
          },
          "execution_log": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Log"
          }
        },
        "type": "object",
        "required": [
          "committed",
          "state_version"
        ],
        "title": "ConfirmResponse",
        "description": "Represent the documented Confirm plan response."
      },
      "ExecutionLogResponse": {
        "properties": {
          "entries": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "entries"
        ],
        "title": "ExecutionLogResponse",
        "description": "Represent execution log entries."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryResponse": {
        "properties": {
          "entries": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Entries"
          },
          "state_version": {
            "type": "integer",
            "title": "State Version"
          }
        },
        "type": "object",
        "required": [
          "entries",
          "state_version"
        ],
        "title": "MemoryResponse",
        "description": "Represent stored memory entries and current state version."
      },
      "PlanResponse": {
