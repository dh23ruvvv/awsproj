          "provider_used": {
            "type": "string",
            "title": "Provider Used"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded"
          }
        },
        "type": "object",
        "required": [
          "plan_id",
          "status",
          "proposed_blocks",
          "state_version_at_proposal",
          "provider_used",
          "degraded"
        ],
        "title": "PlanResponse",
        "description": "Represent the documented Plan details response."
      },
      "ScheduleResponse": {
        "properties": {
